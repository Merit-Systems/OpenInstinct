#!/usr/bin/env bash
set -euo pipefail

mode="${1:-start}"
shift || true

case "$mode" in
  dev | start) ;;
  *)
    printf 'Unknown local app mode: %s\n' "$mode" >&2
    exit 2
    ;;
esac

port="${PORT:?Portless did not assign an application port.}"
public_url="${PORTLESS_URL:-http://127.0.0.1:$port}"

printf '\nLocal Vault Assistant: %s\n\n' "$public_url"

if [[ "${LOCAL_VAULT_ASSISTANT_NO_OPEN:-0}" != "1" ]] && \
  command -v open >/dev/null 2>&1; then
  (
    for _ in {1..120}; do
      if curl --silent --fail "http://127.0.0.1:$port" >/dev/null 2>&1; then
        open "$public_url"
        exit
      fi
      sleep 0.25
    done
  ) >/dev/null 2>&1 &
fi

exec node node_modules/next/dist/bin/next "$mode" \
  --hostname "${HOST:-127.0.0.1}" --port "$port" "$@"
