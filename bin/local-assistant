#!/usr/bin/env bash
set -euo pipefail

repository_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_directory"

readonly EVE_HOST="127.0.0.1"
readonly EVE_PORT="4274"
readonly LOCAL_URL="https://local-vault-assistant.localhost"

if command -v pnpm >/dev/null 2>&1; then
  package_manager=(pnpm)
else
  package_manager=(corepack pnpm)
fi

if [[ ! -d node_modules ]]; then
  "${package_manager[@]}" install
fi

mode="start"
while (($# > 0)); do
  case "$1" in
    --dev)
      mode="dev"
      shift
      ;;
    --no-open)
      export LOCAL_VAULT_ASSISTANT_NO_OPEN=1
      shift
      ;;
    doctor)
      failures=0
      printf 'Local Vault Assistant\n\n'
      if [[ "$(uname -s)" == "Darwin" ]]; then
        printf '✓ macOS\n'
      else
        printf '✗ macOS Keychain is unavailable\n'
        failures=$((failures + 1))
      fi
      if [[ "$(node -p 'process.versions.node.split(".")[0]')" == "24" ]]; then
        printf '✓ Node.js %s\n' "$(node --version)"
      else
        printf '✗ Node.js 24 is required\n'
        failures=$((failures + 1))
      fi
      if command -v pnpm >/dev/null 2>&1; then
        printf '✓ pnpm %s\n' "$(pnpm --version)"
      else
        printf '✗ pnpm is unavailable\n'
        failures=$((failures + 1))
      fi
      if [[ -x node_modules/.bin/portless ]]; then
        printf '✓ Portless %s\n' "$(node_modules/.bin/portless --version)"
      else
        printf '✗ Portless is unavailable\n'
        failures=$((failures + 1))
      fi
      if [[ -x /usr/bin/security ]]; then
        printf '✓ macOS Keychain command\n'
      else
        printf '✗ macOS Keychain command is unavailable\n'
        failures=$((failures + 1))
      fi
      if [[ -f .output/.local-vault-assistant-build && -f .next/BUILD_ID ]]; then
        printf '✓ Agent and manager production builds\n'
      else
        printf '• Production builds will be created on first launch\n'
      fi
      printf '• Manager URL: %s\n' "$LOCAL_URL"
      exit "$failures"
      ;;
    update)
      exec "$repository_directory/install.sh"
      ;;
    *)
      break
      ;;
  esac
done

if [[ ! -x node_modules/.bin/portless ]]; then
  "${package_manager[@]}" install
fi

"${package_manager[@]}" exec portless proxy start

existing_url="$(
  "${package_manager[@]}" exec portless list 2>/dev/null | \
    awk '$1 ~ /^https?:\/\/local-vault-assistant\./ { print $1; exit }'
)"
if [[ -n "$existing_url" ]]; then
  if curl --insecure --silent --fail "$existing_url" >/dev/null 2>&1; then
    printf '\nLocal Vault Assistant is already running: %s\n\n' "$existing_url"
    if [[ "${LOCAL_VAULT_ASSISTANT_NO_OPEN:-0}" != "1" ]] && \
      command -v open >/dev/null 2>&1; then
      open "$existing_url"
    fi
    exit 0
  fi
  "${package_manager[@]}" exec portless alias \
    --remove local-vault-assistant >/dev/null 2>&1 || true
fi

if [[ "$mode" == "start" && ! -f .output/.local-vault-assistant-build ]]; then
  "${package_manager[@]}" build:eve
  [[ -f .output/server/index.mjs ]]
  touch .output/.local-vault-assistant-build
fi

if [[ "$mode" == "start" && ! -f .next/BUILD_ID ]]; then
  EVE_NEXT_PRODUCTION_ORIGIN="http://$EVE_HOST:$EVE_PORT" \
    "${package_manager[@]}" build
fi

eve_pid=""
browser_pid=""
web_pid=""
telegram_pid=""
route_registered=0
cleanup() {
  if [[ "$route_registered" == "1" ]]; then
    "${package_manager[@]}" exec portless alias \
      --remove local-vault-assistant >/dev/null 2>&1 || true
  fi
  if [[ -n "$web_pid" ]] && kill -0 "$web_pid" >/dev/null 2>&1; then
    kill -TERM "$web_pid" >/dev/null 2>&1 || true
    wait "$web_pid" 2>/dev/null || true
  fi
  if [[ -n "$telegram_pid" ]] && kill -0 "$telegram_pid" >/dev/null 2>&1; then
    kill -TERM "$telegram_pid" >/dev/null 2>&1 || true
    wait "$telegram_pid" 2>/dev/null || true
  fi
  if [[ -n "$browser_pid" ]] && kill -0 "$browser_pid" >/dev/null 2>&1; then
    kill -TERM "$browser_pid" >/dev/null 2>&1 || true
    wait "$browser_pid" 2>/dev/null || true
  fi
  if [[ -n "$eve_pid" ]] && kill -0 "$eve_pid" >/dev/null 2>&1; then
    kill "$eve_pid" >/dev/null 2>&1 || true
    wait "$eve_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT

if [[ "$mode" == "start" ]]; then
  HOST="$EVE_HOST" NITRO_HOST="$EVE_HOST" \
    PORT="$EVE_PORT" NITRO_PORT="$EVE_PORT" \
    node .output/server/index.mjs &
  eve_pid=$!

  eve_ready=0
  for _ in {1..120}; do
    if ! kill -0 "$eve_pid" >/dev/null 2>&1; then
      wait "$eve_pid" || true
      printf 'The local agent runtime stopped before it became ready.\n' >&2
      exit 1
    fi
    if curl --silent --fail \
      "http://$EVE_HOST:$EVE_PORT/eve/v1/health" >/dev/null 2>&1; then
      eve_ready=1
      break
    fi
    sleep 0.25
  done

  if [[ "$eve_ready" != "1" ]]; then
    printf 'The local agent runtime did not become ready on port %s.\n' \
      "$EVE_PORT" >&2
    exit 1
  fi
fi

node --experimental-strip-types scripts/local-browser-daemon.ts &
browser_pid=$!

browser_ready=0
for _ in {1..120}; do
  if ! kill -0 "$browser_pid" >/dev/null 2>&1; then
    wait "$browser_pid" || true
    printf 'The local browser service stopped before it became ready.\n' >&2
    exit 1
  fi
  if curl --silent --output /dev/null --request POST \
    --header 'Content-Type: application/json' --data '{}' \
    "http://127.0.0.1:4275/action"; then
    browser_ready=1
    break
  fi
  sleep 0.25
done

if [[ "$browser_ready" != "1" ]]; then
  printf 'The local browser service did not become ready on port 4275.\n' >&2
  exit 1
fi

app_port="$(
  node -e \
    'const net=require("node:net");const server=net.createServer();server.listen(0,"127.0.0.1",()=>{console.log(server.address().port);server.close()})'
)"

node node_modules/next/dist/bin/next "$mode" \
  --hostname 127.0.0.1 --port "$app_port" "$@" &
web_pid=$!

web_ready=0
for _ in {1..120}; do
  if ! kill -0 "$web_pid" >/dev/null 2>&1; then
    wait "$web_pid" || true
    printf 'The local manager stopped before it became ready.\n' >&2
    exit 1
  fi
  if curl --silent --fail "http://127.0.0.1:$app_port" >/dev/null 2>&1; then
    web_ready=1
    break
  fi
  sleep 0.25
done

if [[ "$web_ready" != "1" ]]; then
  printf 'The local manager did not become ready.\n' >&2
  exit 1
fi

node scripts/telegram-poller.mjs "http://127.0.0.1:$app_port" &
telegram_pid=$!

"${package_manager[@]}" exec portless alias \
  local-vault-assistant "$app_port"
route_registered=1

public_url="$(
  "${package_manager[@]}" exec portless list 2>/dev/null | \
    awk '$1 ~ /^https?:\/\/local-vault-assistant\./ { print $1; exit }'
)"
public_url="${public_url:-$LOCAL_URL}"
printf '\nLocal Vault Assistant: %s\n\n' "$public_url"

if [[ "${LOCAL_VAULT_ASSISTANT_NO_OPEN:-0}" != "1" ]] && \
  command -v open >/dev/null 2>&1; then
  open "$public_url"
fi

trap 'exit 130' INT
trap 'exit 143' TERM

set +e
wait "$web_pid"
web_status=$?
set -e
exit "$web_status"
