# Optional in local development; required elsewhere.
# Better Auth passwordless SMS.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# The Neon Marketplace resource injects these automatically on Vercel. `pnpm
# dev` overrides both with the local Docker Compose database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Required for browser execution outside the Vercel one-click flow.
# The Kernel Marketplace resource injects this automatically on Vercel.
KERNEL_API_KEY=
# Vercel injects BLOB_STORE_ID and VERCEL_OIDC_TOKEN when a private Blob store
# is connected. Outside Vercel, set a read-write token instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Coinbase for Agents. Use a CDP API key with only the permissions you need.
COINBASE_KEY_ID=
COINBASE_KEY_SECRET=
# Comma-separated Better Auth principal IDs returned by coinbase_access_status.
COINBASE_ALLOWED_USER_IDS=

# Agentcash x402/MPP wallet. Configure one or both network keys.
X402_PRIVATE_KEY=
X402_SOLANA_PRIVATE_KEY=
# Comma-separated Better Auth principal IDs returned by agentcash_access_status.
AGENTCASH_ALLOWED_USER_IDS=
# Hard per-request payment ceiling in USD. Every paid call also supplies a lower
# or equal caller-visible ceiling and requires explicit approval.
AGENTCASH_MAX_PAYMENT_USD=5
# Optional Vercel Connect configuration.
GOOGLE_CONNECTOR_UID=
# Configure both Linq values together to enable iMessage and phone sign-in.
LINQ_CONNECTOR=
LINQ_PHONE_NUMBER=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
