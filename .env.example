# Better Auth passwordless SMS.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# The Neon Marketplace resource injects this automatically on Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Required for browser execution outside the Vercel one-click flow.
# The Kernel Marketplace resource injects this automatically on Vercel.
KERNEL_API_KEY=
# Direct Anthropic model access.
ANTHROPIC_API_KEY=
# Optional bearer secret for the internal production model smoke check.
MODEL_SMOKE_SECRET=
# User-scoped Google OAuth connector managed by Vercel Connect.
GOOGLE_CONNECTOR_UID=google/open-instinct
# Required when Linq sends signed webhooks directly instead of through Connect.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
