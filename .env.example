# Better Auth passwordless SMS.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# The Neon Marketplace resource injects this automatically on Vercel.
DATABASE_URL=
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Required for browser execution outside the Vercel one-click flow.
# The Kernel Marketplace resource injects this automatically on Vercel.
KERNEL_API_KEY=
# Optional: route inference through TrustedRouter instead of the Vercel AI
# Gateway. Setting the key switches both the model catalog and every model
# call; leaving it empty keeps the AI Gateway path.
TRUSTEDROUTER_API_KEY=
# Defaults to https://api.trustedrouter.com/v1
TRUSTEDROUTER_BASE_URL=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
