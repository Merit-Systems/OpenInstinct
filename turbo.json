{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "KERNEL_API_KEY",
    "SECRET_ENCRYPTION_KEY",

    "EVE_NEXT_PRODUCTION_ORIGIN",
    "GOOGLE_CONNECTOR_UID",
    "NODE_ENV",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build:app": {
      "dependsOn": ["^build:app"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "build:vercel": {
      "dependsOn": ["db:migrate"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev:app": {
      "cache": false,
      "persistent": true
    },
    "deploy:app": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "knip": {
      "outputs": []
    },
    "lint:app": {
      "outputs": []
    },
    "start:app": {
      "cache": false,
      "persistent": true
    },
    "test:app": {
      "outputs": []
    },
    "types:generate": {
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "types:check:app": {
      "dependsOn": ["types:generate"],
      "outputs": ["*.tsbuildinfo"]
    }
  }
}
