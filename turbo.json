{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "EVE_NEXT_PRODUCTION_ORIGIN",
    "HOSTED_SECRET_ENCRYPTION_KEY",
    "KERNEL_API_KEY",
    "LOCAL_VAULT_ASSISTANT_ALLOW_REMOTE_MANAGER",
    "LOCAL_VAULT_ASSISTANT_BROWSER_EXECUTABLE",
    "LOCAL_VAULT_ASSISTANT_BROWSER_VISIBLE",
    "LOCAL_VAULT_ASSISTANT_DATA_DIR",
    "LOCAL_VAULT_ASSISTANT_KERNEL_IMAGE_API_URL",
    "LOCAL_VAULT_ASSISTANT_KERNEL_IMAGE_CDP_URL",
    "LOCAL_VAULT_ASSISTANT_MODEL",
    "LOCAL_VAULT_ASSISTANT_MODEL_API_KEY",
    "LOCAL_VAULT_ASSISTANT_MODEL_BASE_URL",
    "LOCAL_VAULT_ASSISTANT_MODE",
    "TEXTBELT_API_KEY",
    "VERCEL",
    "VERCEL_REGION"
  ],
  "tasks": {
    "build:app": {
      "dependsOn": ["^build:app"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev:app": {
      "cache": false,
      "persistent": true
    },
    "deploy:app": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "foundation:check": {
      "outputs": []
    },
    "knip": {
      "outputs": []
    },
    "lint:app": {
      "outputs": []
    },
    "start:app": {
      "cache": false,
      "persistent": true
    },
    "test:app": {
      "outputs": []
    },
    "types:check:app": {
      "outputs": ["*.tsbuildinfo"]
    },
    "ui:check": {
      "outputs": []
    },
    "ui:integrity": {
      "env": [
        "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
        "ACTIONS_ID_TOKEN_REQUEST_URL",
        "MERIT_REGISTRY_OIDC_TOKEN"
      ],
      "inputs": [
        "components.json",
        "package.json",
        "tsconfig.json",
        "components/**",
        "app/globals.css",
        "foundation.config.ts",
        "pnpm-lock.yaml"
      ],
      "outputs": []
    }
  }
}
