  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "bench:browser": "eve eval browser",
    "bench:compare": "node --experimental-strip-types scripts/compare-browser-benchmarks.ts",
    "boundaries": "turbo boundaries",
    "build": "turbo run build:app",
    "build:app": "next build",
    "check": "turbo run lint:app types:check:app test:app ui:check ui:integrity format:check foundation:check knip && turbo boundaries",
    "check:foundation": "turbo run lint:app types:check:app test:app ui:check format:check foundation:check knip && turbo boundaries",
    "deps:check": "taze --fail-on-outdated",
    "deploy": "turbo run deploy:app",
    "deploy:app": "eve deploy",
    "dev": "turbo run dev:app",
    "dev:app": "next dev",
    "eval": "eve eval",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "foundation:check": "merit conformance check",
    "knip": "knip --config knip.config.ts",
    "lint": "turbo run lint:app",
    "lint:app": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "start": "turbo run start:app",
    "start:app": "next start",
    "test": "turbo run test:app",
    "test:app": "vitest run",
    "types:check": "turbo run types:check:app",
    "types:check:app": "tsc --noEmit -p tsconfig.json",
    "ui:check": "merit ui check --root .",
    "ui:integrity": "merit ui integrity check --root .",
    "ui:integrity:github": "node scripts/ui-integrity.ts",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start"
  },
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
